# Copy to .env.local and fill in once you've created a Supabase project.
# Until these are set, the GraphQL API falls back to the seed data in
# lib/projects.ts (see lib/supabase.ts) — the site works without them.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Used by lib/graphql-client.ts to call this app's own /api/graphql route.
# Not needed locally (defaults to http://localhost:3000) or on Vercel
# (falls back to the VERCEL_URL env var Vercel sets automatically).
NEXT_PUBLIC_SITE_URL=
